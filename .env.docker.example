# Copy to .env and replace every value before `docker compose up -d`.
# APP_URL must be a public HTTPS URL: Telegram Mini App requires HTTPS.

APP_URL=https://funbox.example.com
PUBLIC_API_URL=https://funbox.example.com
CORS_ORIGINS=https://funbox.example.com
API_PORT=4000

POSTGRES_USER=funbox
POSTGRES_PASSWORD=change-this-strong-database-password
POSTGRES_DB=funbox

# Generate: openssl rand -hex 32
JWT_SECRET=change-this-to-a-64-character-random-secret
JWT_EXPIRES_IN=7d

# From @BotFather
BOT_TOKEN=123456789:replace-with-real-bot-token
BOT_USERNAME=your_funbox_bot
# Generate: openssl rand -hex 24
BOT_SECRET=change-this-to-a-random-internal-secret

# Comma-separated Telegram user IDs that become ADMIN on first login.
ADMIN_TELEGRAM_IDS=123456789

TELEGRAM_INIT_TTL_SECONDS=86400
MAX_UPLOAD_MB=8
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180

# First production start: apply migrations + seed content only (no demo users).
SEED_ON_START=true
DEMO_AUTH_ENABLED=false
