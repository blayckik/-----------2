{
  "name": "@funbox/bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --out-dir dist --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "telegraf": "4.16.3"
  },
  "devDependencies": {
    "@types/node": "22.13.5",
    "tsup": "8.3.6",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}
