# API server (copy to apps/api/.env for local development)
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local PGlite PostgreSQL (pnpm db:start). For real PostgreSQL remove &pgbouncer=true.
DATABASE_URL=postgresql://postgres:funbox@127.0.0.1:5433/postgres?schema=public&pgbouncer=true&pgbouncer=true

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
TELEGRAM_INIT_TTL_SECONDS=86400
DEMO_AUTH_ENABLED=true

# Telegram — fill to enable real initData auth and bot notifications
BOT_TOKEN=
BOT_USERNAME=funbox_demo_bot
BOT_SECRET=replace-with-bot-internal-secret
TELEGRAM_WEBAPP_URL=http://localhost:5173
ADMIN_TELEGRAM_IDS=

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
