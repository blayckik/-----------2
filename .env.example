# Reference for local development. Copy the scoped examples instead:
#   apps/api/.env.example → apps/api/.env
#   apps/bot/.env.example → apps/bot/.env
#   apps/web/.env.example → apps/web/.env
# For Docker use .env.docker.example → .env

# ── Core ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:funbox@127.0.0.1:5433/postgres?schema=public&pgbouncer=true

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
TELEGRAM_INIT_TTL_SECONDS=86400
DEMO_AUTH_ENABLED=true

# ── Telegram ─────────────────────────────────────────────────
BOT_TOKEN=
BOT_USERNAME=funbox_demo_bot
BOT_SECRET=replace-with-bot-internal-secret
TELEGRAM_WEBAPP_URL=http://localhost:5173
ADMIN_TELEGRAM_IDS=

# ── Uploads ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# ── Rate limits ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180

# ── Optional integrations ────────────────────────────────────
REDIS_URL=
